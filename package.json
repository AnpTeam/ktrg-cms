{
  "name": "ktrg-cms",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*"],
  "scripts": {
    "ktrg": "bun apps/api/scripts/ktrg.ts",
    "setup:git": "git config merge.po-catalog.name \"Lingui catalogs\" && git config merge.po-catalog.driver \"bun apps/web/scripts/merge-po.ts %O %A %B\"",
    "prepare": "bun run setup:git || true",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "check": "bun run typecheck && bun run test",
    "lint": "bun run --filter '*' --if-present lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "bun-plugin-lingui-macro": "^1.1.3"
  },
  "dependencies": {
    "next": "^16.4.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.25.12"
  }
}
