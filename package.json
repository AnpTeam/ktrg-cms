{
  "name": "ktrg-cms",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "lint": "bun run --filter '*' --if-present lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  }
}
