# Port 443 (HTTPS): the site. Left out by 40-ktrg-https.sh until Certbot has the certificate.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Certificate from Let's Encrypt (Certbot saves it under the name "ktrg"). TLS 1.2 and 1.3 only (設計書 2.4.5-3).
    ssl_certificate     /etc/letsencrypt/live/ktrg/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ktrg/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;

    # Requests to the API are small (a 4 MB photo plus its form)...
    client_max_body_size 8m;

    # ...except this one signed address, where a video (up to 200 MB) arrives in one PUT. It goes straight to the API
    # instead of being saved on nginx's disk first.
    location /api/v1/uploads/direct/ {
        client_max_body_size 210m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://api:3001;
    }

    # The API. The path is passed on as it is (/api/v1/...): no "/" after the port, which would cut "/api" off.
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://api:3001;
    }

    # Uploaded files (storage_data, mounted at /srv/files). A file's name never changes, so it is cached for a year;
    # subtitles (.vtt) can be replaced, so 5 minutes. Unfinished uploads (*.part-*) are never served.
    location /files/ {
        root /srv;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";

        location ~ \.part- {
            return 404;
        }
        location ~ \.vtt$ {
            types { }
            default_type "text/vtt; charset=utf-8";
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=300";
        }
    }

    # Everything else: the website.
    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://web:3000;
    }
}
