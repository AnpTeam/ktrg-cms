{
  "name": "@ktrg/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/server.ts",
    "start": "bun --env-file=../../.env src/server.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "phone:test": "bun scripts/phone-test.ts",
    "mail:test": "bun --env-file=../../.env scripts/send-test-mail.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:migrate:ci": "drizzle-kit migrate",
    "db:seed": "bun --env-file=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@elysia/openapi": "^1.4.17",
    "@simplewebauthn/server": "^14.1.0",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.31",
    "kuromoji": "^0.1.2",
    "nodemailer": "^10.4.0",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
