# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose)
POSTGRES_USER=ktrg
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ktrg
# Change this (for example to 5433) if another PostgreSQL already uses 5432 on your machine
# (Docker then says "ports are not available"), and use the same port in DATABASE_URL below.
POSTGRES_PORT=5432

# API (host: localhost; in compose the api service overrides the host with "db")
DATABASE_URL=postgres://ktrg:change_me@localhost:5432/ktrg
APP_ORIGIN=http://localhost:3000

# Mail: leave SMTP_HOST empty in dev to log emails to the console.
# Gmail: smtp.gmail.com, port 587, user = address, pass = an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KTRG <no-reply@localhost>"

# Web (Next.js rewrites /api/* to this origin)
API_ORIGIN=http://localhost:3001

# One-time login codes: hashing key. Required in production, 32+ characters.
OTP_HMAC_SECRET=

# Secret for the scheduled clean-up that erases accounts 3 days after a deletion request (32+ random characters).
# The same value goes in the GitHub repository secret CRON_SECRET (see .github/workflows/purge-deletions.yml).
# Unset: the clean-up route does not exist.
CRON_SECRET=

# Set to true ONLY behind a trusted proxy (e.g. Vercel) so rate limits use the real client IP.
TRUST_PROXY=false

# First admin: comma-separated emails that become admin when they log in with an email code.
# Promote-only: taking an address off this list does NOT demote that account.
ADMIN_EMAILS=

# API docs at /api/v1/openapi (and the OpenAPI JSON at /api/v1/openapi/json).
# Always on in development; off in production unless this is true.
API_DOCS=false

# Passkeys: defaults to the hostname of APP_ORIGIN. Passkeys only work on this domain.
# PASSKEY_RP_ID=

# Web: sample and draft routes and spots (labelled on every screen). On by default in development;
# set 0 to see the real empty state. Off elsewhere: set 1 only for a preview deployment.
# Next reads env files from apps/web, not from this repo-root .env.
SHOW_SAMPLE_CONTENT=

# Web: intro video on the signed-out home page (a YouTube or Vimeo https link). Empty = no video section.
INTRO_VIDEO_URL=

# Web: the site's public address with no trailing slash, used by /sitemap.xml and /robots.txt (for example https://example.com).
SITE_URL=

# Web: link to the blog, shown under the notices on the signed-out home page (an https link). Empty = no link.
BLOG_URL=

# Photo uploads (POST /api/v1/admin/uploads) to Cloudflare R2: set all five or none.
# R2 → Manage API tokens → "Object Read & Write" on the bucket gives the key id and secret.
# R2_PUBLIC_URL: the bucket's public address (r2.dev URL or a custom domain), https, no trailing slash.
# Unset: uploads answer 503 and the rest of the app works as before.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
